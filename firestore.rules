rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Shared Studio Workspace (Cross-device real-time sync for 2-5 team members):
    // Allows all team devices (PC, Phone, iPad) to read, sync, and update studio data in real time
    match /studios/{studioId} {
      allow read, write: if true;

      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // 2. Individual User Accounts and Profiles
    match /users/{userId} {
      allow read, write: if true;

      match /{allPaths=**} {
        allow read, write: if true;
      }
    }
  }
}
